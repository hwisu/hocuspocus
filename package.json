{
	"name": "hocuspocus-jvm-compat",
	"private": true,
	"packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
	"type": "module",
	"scripts": {
		"lint:compat": "biome lint benchmark interop scripts package.json",
		"test:jvm:interop": "bash scripts/test-interop.sh",
		"test:jvm:migration": "HOCUSPOCUS_BENCHMARK_SCRIPT=./benchmark/compare-infrastructure.mjs bash scripts/benchmark-ab.sh --compatibility-only --check",
		"test:jvm:benchmark-stats": "node --test benchmark/process-stats.test.mjs",
		"test:jvm:matrix": "node scripts/verify-upstream-server-matrix.mjs",
		"test:jvm:security": "node scripts/check-runtime-vulnerabilities.mjs",
		"benchmark:jvm:ab": "bash scripts/benchmark-ab.sh",
		"benchmark:jvm:infra-ab": "HOCUSPOCUS_BENCHMARK_SCRIPT=./benchmark/compare-infrastructure.mjs bash scripts/benchmark-ab.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@hocuspocus/common": "4.6.0",
		"@hocuspocus/extension-database": "4.6.0",
		"@hocuspocus/extension-redis": "4.6.0",
		"@hocuspocus/extension-sqlite": "4.6.0",
		"@hocuspocus/provider": "4.6.0",
		"@hocuspocus/server": "4.6.0",
		"y-protocols": "1.0.6",
		"yjs": "13.6.32"
	},
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3"
		]
	},
	"repository": {
		"url": "https://github.com/hwisu/hocuspocus"
	}
}
